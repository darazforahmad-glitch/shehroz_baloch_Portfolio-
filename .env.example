# Copy to .env for local development, or paste these into
# Vercel -> Project -> Settings -> Environment Variables.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-long-random-string

# Leave DEBUG off everywhere except your own machine.
DEBUG=False

# Comma separated. Vercel's own *.vercel.app domain is already allowed;
# add a custom domain here once you connect one.
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

TIME_ZONE=Asia/Karachi

# --- Contact form email (all four needed, otherwise messages are logged) ---
# For Gmail you must use an App Password, not your normal password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com
